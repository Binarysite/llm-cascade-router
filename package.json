{
  "name": "llm-cascade-router",
  "version": "0.1.1",
  "description": "Answer each chat message with the cheapest layer that can: exact match, local scoring, a cheap classifier, and only then the LLM. Zero runtime dependencies.",
  "type": "module",
  "private": true,
  "main": "src/index.js",
  "types": "index.d.ts",
  "bin": {
    "llm-cascade-router": "bin/cascade.js"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./src/index.js"
    },
    "./claude": {
      "types": "./claude.d.ts",
      "default": "./src/adapters/claude.js"
    },
    "./openai-compatible": {
      "types": "./openai-compatible.d.ts",
      "default": "./src/adapters/openai-compatible.js"
    },
    "./eval": {
      "types": "./eval.d.ts",
      "default": "./src/eval.js"
    }
  },
  "files": [
    "src",
    "bin",
    "index.d.ts",
    "claude.d.ts",
    "eval.d.ts",
    "openai-compatible.d.ts",
    "examples",
    "LICENSE",
    "README.md",
    "NOTICE"
  ],
  "scripts": {
    "test": "node --test",
    "bench": "node bench/run.js",
    "bench:real": "node bench/real.js",
    "clinc:fetch": "node bench/clinc150/fetch.js",
    "clinc": "node bench/clinc150/run.js && node bench/clinc150/chart.js && node bench/clinc150/show.js",
    "clinc:model": "node bench/clinc150/model.js",
    "cost": "node bench/cost.js",
    "ask": "node examples/sticker-shop/ask.js",
    "measure": "node bin/cascade.js",
    "coverage": "node --test --experimental-test-coverage --test-coverage-include='src/**' --test-coverage-lines=95 --test-coverage-branches=90",
    "lint": "node scripts/lint.mjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.tools.json && tsc -p tsconfig.strict.json"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "llm",
    "agents",
    "chatbot",
    "routing",
    "cascade",
    "intent-classification",
    "cost"
  ],
  "author": "Alfredo Rosadilla",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Binarysite/llm-cascade-router.git"
  },
  "homepage": "https://github.com/Binarysite/llm-cascade-router#readme",
  "bugs": {
    "url": "https://github.com/Binarysite/llm-cascade-router/issues"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "7.0.2"
  }
}
